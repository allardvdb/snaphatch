#!/bin/bash
# snaphatch-poll - Poll the ScanSnap button and run snaphatch-scan (part of snaphatch)
# Designed to be started/stopped by udev on USB connect/disconnect.
# Works with any ScanSnap model supported by the SANE fujitsu backend.

POLL_INTERVAL=0.1
DEBOUNCE=3

# Resolve scan script relative to this script's location
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SCAN_SCRIPT="$SCRIPT_DIR/snaphatch-scan"

log() {
    # Journald adds its own timestamp; no point duplicating it here.
    echo "$1"
}

# Auto-detect scanner device (fallback when SCANNER_DEVICE is not set).
# Matches any ScanSnap model, e.g. `fujitsu:ScanSnap iX500:262571`,
# `fujitsu:ScanSnap S1500:262571`.
detect_device() {
    scanimage -L 2>/dev/null | grep -oP "fujitsu:ScanSnap [^:]+:\d+" | head -1
}

get_button_state() {
    # Read scanner options, extract scan button state
    scanimage --device "$DEVICE" -A 2>/dev/null | grep -oP '(?<=--scan\[=\(yes\|no\)\] \[)\w+' || echo "error"
}

# Notification servers render a small subset of HTML in the body, so a file
# name or server response with & or < would break or garble it
escape_markup() {
    sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
}

# done_target SCAN_OUTPUT - the path or file name from scan's
# `Done: <path-or-filename> (<pages> pages, <size>)...` line; may contain spaces
done_target() {
    echo "$1" | sed -n 's/^Done: \(.*\) ([0-9]* pages, .*$/\1/p' | tail -1
}

# error_message SCAN_OUTPUT - the most relevant error line for the notification.
# scan's own messages come first: after a failed upload, the server's response
# body follows "Upload failed" and may itself contain "error".
error_message() {
    local msg
    msg=$(echo "$1" | grep -E '^(Error:|Upload failed|No pages)' | tail -1)
    [ -n "$msg" ] || msg=$(echo "$1" | grep -iE 'error|failed' | tail -1)
    echo "${msg:-Something went wrong during scanning}"
}

# kept_file SCAN_OUTPUT - the PDF that scan kept in scanner-inbox/failed/,
# from its `Error: <reason>; scan kept as <path>` line; empty if none
kept_file() {
    echo "$1" | sed -n 's/^Error: .*; scan kept as \(.*\)$/\1/p' | tail -1
}

# Sourced (by tests/test-poll.sh): only define the functions above
if [ "${BASH_SOURCE[0]}" != "$0" ]; then
    return 0
fi

# Remove the scan log if the service is stopped mid-scan
trap 'rm -f "${SCAN_LOG:-}"' EXIT
trap 'exit 143' TERM INT

# Scanner device — from env or auto-detect
if [ -n "$SCANNER_DEVICE" ]; then
    DEVICE="$SCANNER_DEVICE"
else
    # Right after plug-in SANE may not list the scanner yet: retry for ~30s
    for _ in $(seq 15); do
        DEVICE=$(detect_device)
        [ -n "$DEVICE" ] && break
        sleep 2
    done
fi
if [ -z "$DEVICE" ]; then
    # Exit 0, not 1: the udev rule starts this service for any ScanSnap,
    # including models the fujitsu backend can't drive, and with
    # Restart=on-failure those would be retried every 5s forever
    log "No ScanSnap found that the SANE fujitsu backend supports (scanimage -L); not polling."
    log "Models that need another SANE backend, such as epjitsu for the S1100 and S1300i, are not supported."
    exit 0
fi

log "Starting button poll for $DEVICE"

# Wait for scanner to be ready
sleep 2

# Main polling loop
while true; do
    button_state=$(get_button_state)

    if [ "$button_state" = "yes" ]; then
        log "Button pressed! Starting scan..."

        # Send the initial popup WITHOUT -r (so it actually pops up) and
        # capture the server-assigned ID via --print-id. -t 0 keeps the
        # popup alive for the whole scan so stage updates from `scan` can
        # replace it visibly (a -r against an expired popup lands silently
        # in notification history). `scan` inherits NOTIFY_ID via env.
        NOTIFY_ID=$(notify-send --print-id -t 0 -i scanner \
            "Scanning" "Starting scan…" 2>/dev/null) || NOTIFY_ID=""
        export NOTIFY_ID

        # Stream scan output through tee so the journal sees each line as it
        # happens — otherwise `SCAN_OUTPUT=$(...)` captures the whole run
        # into memory and the journal gets everything in one burst at the
        # end (with identical timestamps).
        SCAN_LOG=$(mktemp)
        "$SCAN_SCRIPT" 2>&1 | tee "$SCAN_LOG"
        if [ "${PIPESTATUS[0]}" -eq 0 ]; then
            SCAN_OK=true
        else
            SCAN_OK=false
        fi
        SCAN_OUTPUT=$(cat "$SCAN_LOG")
        rm -f "$SCAN_LOG"

        # Pick up NOTIFY_ID if scan captured one itself (manual run) or updated
        # it during the pipeline. `export` is a no-op for bash builtins we already
        # `export`ed, but the value is what matters — scan's notify_progress
        # assigns NOTIFY_ID in its own process so we can't see changes; rely on
        # our own captured ID above. If it's empty (notify-send missing/failed),
        # the helper falls back to sending without -r.
        replace_args=()
        [ -n "$NOTIFY_ID" ] && replace_args=(-r "$NOTIFY_ID")

        if [ "$SCAN_OK" = true ]; then
            log "Scan completed successfully"
            # `scan` logs `Done: <path-or-filename> (<pages> pages, <size>)`; pull
            # that out so the notification can show what was actually produced.
            DONE_TARGET=$(done_target "$SCAN_OUTPUT")
            DONE_NAME=$(basename "$DONE_TARGET" | escape_markup)
            # e.g. " (1 blank page(s) removed)", from the scan script's output
            REMOVED=$(echo "$SCAN_OUTPUT" | grep -oP '(?<=^Removed )\d+(?= blank page)' || true)
            NOTE=""
            [ -n "$REMOVED" ] && NOTE=" ($REMOVED blank page(s) removed)"
            # Send clickable desktop notification (in background to not block polling).
            if [ -n "$PAPERLESS_URL" ]; then
                (
                    ACTION=$(notify-send "${replace_args[@]}" -i scanner --action="open=Open in Paperless" \
                        "Scan Complete" "Uploaded $DONE_NAME to Paperless$NOTE" 2>/dev/null)
                    [ "$ACTION" = "open" ] && xdg-open "$PAPERLESS_URL" 2>/dev/null
                ) &
            elif [ -n "$PAPERLESS_CONSUME_DIR" ]; then
                (
                    ACTION=$(notify-send "${replace_args[@]}" -i scanner --action="open=Open" \
                        "Scan Complete" "Saved $DONE_NAME to consume folder$NOTE" 2>/dev/null)
                    [ "$ACTION" = "open" ] && xdg-open "$DONE_TARGET" 2>/dev/null
                ) &
            else
                (
                    ACTION=$(notify-send "${replace_args[@]}" -i scanner --action="open=Open" \
                        "Scan Complete" "Saved $DONE_NAME to scanner-inbox$NOTE" 2>/dev/null)
                    [ "$ACTION" = "open" ] && xdg-open "$DONE_TARGET" 2>/dev/null
                ) &
            fi
        else
            log "Scan failed"
            ERROR_MSG=$(error_message "$SCAN_OUTPUT" | escape_markup)
            KEPT=$(kept_file "$SCAN_OUTPUT")
            folder_action=()
            [ -n "$KEPT" ] && folder_action=(--action="folder=Open folder")
            (
                ACTION=$(notify-send "${replace_args[@]}" -u critical -i dialog-error --action="logs=View Logs" \
                    "${folder_action[@]}" "Scan Failed" "$ERROR_MSG" 2>/dev/null)
                [ "$ACTION" = "folder" ] && xdg-open "$(dirname "$KEPT")" 2>/dev/null
                # Wrap in sh -c so the terminal stays open after the logs are shown
                # (otherwise xdg-terminal-exec closes as soon as journalctl exits).
                # POSIX read: `read -rp` without a variable fails in dash.
                [ "$ACTION" = "logs" ] && xdg-terminal-exec sh -c 'journalctl --user -u snaphatch.service -n 200 --no-pager; echo; printf "Press Enter to close..."; read -r _' 2>/dev/null
            ) &
        fi

        # Debounce - wait before polling again to let button release
        log "Waiting for button release..."
        sleep "$DEBOUNCE"

    elif [ "$button_state" = "error" ]; then
        log "Scanner not responding, waiting..."
        sleep 5
    fi

    sleep "$POLL_INTERVAL"
done
